{
  "_comment": "Template for the Ralph-loop Claude Code session's permission settings. The human operator copies this into ~/.claude/settings.json (or a project .claude/settings.json) on the dedicated orchestrator pod BEFORE launching `meta ralph`. This file is documentation/scaffold — meta/ralph.py never writes here. The Ralph-launched session reads this and the harness enforces the allow/deny rules at tool-call time.",
  "permissions": {
    "allow": [
      "Read(**)",
      "Glob(**)",
      "Grep(**)",
      "Edit(meta/experiments/**/*.yaml)",
      "Write(meta/experiments/**/*.yaml)",
      "Edit(meta/data/experiments/**/report.md)",
      "Write(meta/data/experiments/**/report.md)",
      "Edit(meta/data/scratch/**/*.md)",
      "Write(meta/data/scratch/**/*.md)",
      "Edit(miners/ralph_*/**)",
      "Write(miners/ralph_*/**)",
      "Bash(python -m meta submit *)",
      "Bash(python -m meta status*)",
      "Bash(python -m meta logs --experiment * --unit * --tail *)",
      "Bash(python -m meta compare *)",
      "Bash(python -m meta xcompare*)",
      "Bash(python -m meta export *)",
      "Bash(python -m meta kill --experiment * --unit * --reason *)",
      "Bash(python -m meta scaffold-miner --from * --to * --reason *)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add meta/*)",
      "Bash(git add miners/ralph_*/*)",
      "Bash(git commit -m *)"
    ],
    "deny": [
      "Edit(local/**)",
      "Write(local/**)",
      "Edit(miner_template/**)",
      "Write(miner_template/**)",
      "Edit(shared/**)",
      "Write(shared/**)",
      "Edit(runner/**)",
      "Write(runner/**)",
      "Edit(meta/orchestrator.py)",
      "Edit(meta/providers/**)",
      "Edit(meta/store.py)",
      "Edit(meta/ssh.py)",
      "Edit(meta/ralph.py)",
      "Edit(meta/ingest.py)",
      "Edit(meta/xquery.py)",
      "Edit(meta/dashboard.py)",
      "Edit(meta/dashboard.html)",
      "Edit(meta/__main__.py)",
      "Edit(meta/__init__.py)",
      "Edit(meta/spec.py)",
      "Edit(meta/prompts/**)",
      "Write(meta/prompts/**)",
      "Bash(python -m meta ralph*)",
      "Bash(python -m meta daemon*)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(aws *)",
      "Bash(curl http*)",
      "Bash(wget *)",
      "Bash(rm -rf*)",
      "Bash(git push --force*)"
    ]
  }
}
